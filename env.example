# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ============================================
# These are required for the React app to run

# Clerk Authentication (Get from https://dashboard.clerk.com/apps → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Google Sheets API Key (Get from https://console.cloud.google.com/)
# Enable Google Sheets API and create an API key
VITE_CLIENT_KEY=your_google_api_key_here


# ============================================
# BACKEND/MIGRATION ENVIRONMENT VARIABLES
# ============================================
# These are only needed for the migration script (migrate-to-clerk.cjs)

# Clerk Secret Key (KEEP THIS SECRET! Never commit to git)
# Get from https://dashboard.clerk.com/apps → API Keys
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/


# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Vercel deployment, you only need:
#   - VITE_CLERK_PUBLISHABLE_KEY
#   - VITE_CLIENT_KEY
#
# The CLERK_SECRET_KEY and MONGO_URI are only for
# running the migration script locally.

